# Lấy các giá trị này trong Firebase Console -> Project settings -> Your apps -> Web app (</>)
# Nếu để trống, game chạy "chế độ offline" (lưu tài khoản/tiến trình trong trình duyệt).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Chỉ dùng khi chạy offline trên máy để thử trang /admin (để trống = không đăng nhập admin được). Chế độ Firebase dùng mật khẩu tài khoản admin@gameempire.app tạo trong Firebase Console.
VITE_LOCAL_ADMIN_PASS=
